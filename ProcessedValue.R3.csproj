<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;netstandard2.1;net472</TargetFrameworks>
    <PackageId>ProcessedValue.R3</PackageId>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/GeroiGorodskoyZastroiki/ProcessedValue.R3</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GeroiGorodskoyZastroiki/ProcessedValue.R3</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>data structure;data;delegate;processed;value;generic;R3;reactive</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="R3" Version="1.3.0" />
    <PackageReference Include="ProcessedValue" Version="*" />
  </ItemGroup>

</Project>
